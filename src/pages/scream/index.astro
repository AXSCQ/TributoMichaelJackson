---
import '../../styles/ben.css';
import '../../styles/scream.css';
import ScreamHero from '../../components/Scream/ScreamHero';
const canonicalURL = 'https://tributo.codetec.app/scream/';
const ogImage = 'https://tributo.codetec.app/og/scream.jpg';

// Analíticas (ver el comentario junto a </head>)
const UMAMI_ID = '4d5e3d90-97b6-4cca-8712-b70ebe8db2e4';
const GA_ID = '';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="2xR89xoxTv8Z60ULdARoFZYTnVjTIcKuAaseubjxPMo" />

    <!-- Primary SEO -->
    <title>Michael Jackson — "Scream" (1995) | La Armadura Tecnológica · Tributo Interactivo</title>
    <meta name="description" content="Acto III: Scream (1995). El video más caro de la historia de la música. Una experiencia web con efectos glitch audio-reactivos que captura el grito de Michael Jackson contra la injusticia." />
    <meta name="keywords" content="Michael Jackson, Scream, 1995, Janet Jackson, video más caro, tributo interactivo, experiencia web, glitch, efectos visuales, Rey del Pop" />
    <meta name="author" content="Axel CSCQ" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#050505" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tributo Michael Jackson" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content='Michael Jackson — "Scream" (1995) | La Armadura Tecnológica' />
    <meta property="og:description" content="El video más caro en la historia de la música. Acto III: cuando el grito de MJ rompe la pantalla digitalmente. Experiencia glitch audio-reactiva." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Michael Jackson en el video de «Scream» (1995)" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content='Michael Jackson — "Scream" (1995) | Tributo Interactivo' />
    <meta name="twitter:description" content="Cuando suena el grito, la pantalla se rompe. Experiencia glitch inmersiva en homenaje al Rey del Pop." />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Michael Jackson en el video de «Scream» (1995)" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": 'Michael Jackson — "Scream" | Tributo Interactivo',
        "url": canonicalURL,
        "description": "Experiencia web glitch audio-reactiva dedicada a Scream (1995).",
        "inLanguage": "es",
        "isPartOf": {
            "@type": "WebSite",
            "name": "Tributo Michael Jackson",
            "url": "https://tributo.codetec.app/"
        },
        "author": {
            "@type": "Person",
            "name": "Axel CSCQ",
            "url": "https://axscq.codetec.app/"
        },
        "about": {
            "@type": "MusicRecording",
            "name": "Scream",
            "byArtist": [
                { "@type": "MusicGroup", "name": "Michael Jackson" },
                { "@type": "MusicGroup", "name": "Janet Jackson" }
            ],
            "datePublished": "1995",
            "inAlbum": "HIStory: Past, Present and Future, Book I"
        }
    })} />

    <style>
        .seo-intro { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    </style>
  <!-- Analíticas: Umami propio (pulso.codetec.app, sin cookies) y Google Analytics si hay GA_ID -->
  <script defer src="https://pulso.codetec.app/p.js" data-website-id={UMAMI_ID}></script>
  {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
  {GA_ID && <script is:inline define:vars={{ GA_ID }}>window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', GA_ID);</script>}
</head>
<body class="theme-dark">
    <header class="seo-intro">
        <h1>Michael Jackson — «Scream» (1995): tributo interactivo</h1>
        <p>Acto III: Scream (1995). El video más caro de la historia de la música. Una experiencia web con efectos glitch audio-reactivos que captura el grito de Michael Jackson contra la injusticia.</p>
        <nav aria-label="Actos del tributo">
            <a href="/">Acto I: Ben (1972)</a>
            <a href="/billie-jean/">Acto II: Billie Jean (1982)</a>
            <a href="/scream/">Acto III: Scream (1995)</a>
        </nav>
    </header>
    <ScreamHero client:only="react" />

    <!-- Portfolio credit — subtle footer -->
    <footer style="position:fixed;bottom:1rem;right:1.2rem;z-index:9999;opacity:0;transition:opacity 0.4s;" 
            onmouseenter="this.style.opacity='1'" 
            onmouseleave="this.style.opacity='0'">
        <a href="https://axscq.codetec.app/" 
           target="_blank" 
           rel="noopener noreferrer"
           style="font-size:0.6rem;color:rgba(212,175,55,0.55);text-decoration:none;letter-spacing:0.08em;font-family:monospace;">
            ✦ axscq.dev
        </a>
    </footer>
</body>
</html>
