---
import '../styles/ben.css';
import BenHero from '../components/Ben/BenHero';
const canonicalURL = 'https://tributo.codetec.app/';
const ogImage = 'https://tributo.codetec.app/og/ben.jpg';

// Analíticas (ver el comentario junto a </head>)
const UMAMI_ID = '4d5e3d90-97b6-4cca-8712-b70ebe8db2e4';
const GA_ID = '';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="2xR89xoxTv8Z60ULdARoFZYTnVjTIcKuAaseubjxPMo" />

    <!-- Primary SEO -->
    <title>Michael Jackson — "Ben" (1972) | La Inocencia Aislada · Tributo Interactivo</title>
    <meta name="description" content="Acto I: Ben (1972). Una experiencia web audio-reactiva e inmersiva que explora la soledad y genialidad de Michael Jackson a los 14 años. Música, historia y tecnología en un solo tributo." />
    <meta name="keywords" content="Michael Jackson, Ben 1972, tributo interactivo, experiencia web, Michael Jackson historia, música interactiva, Billie Jean, Scream, Rey del Pop" />
    <meta name="author" content="Axel CSCQ" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tributo Michael Jackson" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content='Michael Jackson — "Ben" (1972) | La Inocencia Aislada' />
    <meta property="og:description" content="Una experiencia web audio-reactiva e inmersiva. La historia de cómo Michael Jackson, a los 14 años, cantó su propia soledad disfrazada de balada pop." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Michael Jackson a los 14 años cantando «Ben» en 1972" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content='Michael Jackson — "Ben" (1972) | Tributo Interactivo' />
    <meta name="twitter:description" content="Una experiencia web inmersiva y audio-reactiva. La tecnología Sonic no se ve, se siente." />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Michael Jackson a los 14 años cantando «Ben» en 1972" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Tributo Michael Jackson",
        "url": canonicalURL,
        "description": "Experiencia web interactiva y audio-reactiva en homenaje a Michael Jackson.",
        "inLanguage": "es",
        "author": {
            "@type": "Person",
            "name": "Axel CSCQ",
            "url": "https://axscq.codetec.app/"
        },
        "about": {
            "@type": "MusicRecording",
            "name": "Ben",
            "byArtist": {
                "@type": "MusicGroup",
                "name": "Michael Jackson"
            },
            "datePublished": "1972"
        }
    })} />

    <!-- Performance hints -->
    <link rel="preload" href="/Ben/bensinfondo.png" as="image" />
    <style>
        .seo-intro { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    </style>
  <!-- Analíticas: Umami propio (pulso.codetec.app, sin cookies) y Google Analytics si hay GA_ID -->
  <script defer src="https://pulso.codetec.app/p.js" data-website-id={UMAMI_ID}></script>
  {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
  {GA_ID && <script is:inline define:vars={{ GA_ID }}>window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', GA_ID);</script>}
</head>
<body>
    <header class="seo-intro">
        <h1>Michael Jackson — «Ben» (1972): tributo interactivo</h1>
        <p>Acto I: Ben (1972). Una experiencia web audio-reactiva e inmersiva que explora la soledad y genialidad de Michael Jackson a los 14 años. Música, historia y tecnología en un solo tributo.</p>
        <nav aria-label="Actos del tributo">
            <a href="/">Acto I: Ben (1972)</a>
            <a href="/billie-jean/">Acto II: Billie Jean (1982)</a>
            <a href="/scream/">Acto III: Scream (1995)</a>
        </nav>
    </header>
    <BenHero client:only="react" />

    <!-- Portfolio credit — subtle footer -->
    <footer style="position:fixed;bottom:1rem;right:1.2rem;z-index:9999;opacity:0;transition:opacity 0.4s;" 
            onmouseenter="this.style.opacity='1'" 
            onmouseleave="this.style.opacity='0'">
        <a href="https://axscq.codetec.app/" 
           target="_blank" 
           rel="noopener noreferrer"
           style="font-size:0.6rem;color:rgba(212,175,55,0.55);text-decoration:none;letter-spacing:0.08em;font-family:monospace;">
            ✦ axscq.dev
        </a>
    </footer>
</body>
</html>
